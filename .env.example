# Native Python / Render. Copy values into the hosting Environment settings.
# For a local .env file: uv run --env-file .env python manage.py runserver
DEBUG=1
SECRET_KEY=replace-with-a-random-secret
ALLOWED_HOSTS=localhost,127.0.0.1
# Production: DEBUG=0 and exact hostnames (no https://).
# CSRF_TRUSTED_ORIGINS=https://portal.example.com

# Render Free / Neon PostgreSQL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
# DB_CONN_MAX_AGE=0
# DATABASE_IMAGE_STORAGE=1
# ENABLE_MAINTENANCE_ENDPOINT=1
# DEPLOY_TOKEN=replace-with-a-different-random-secret
# DB_BACKEND is optional; DATABASE_URL automatically selects PostgreSQL.

# Without DATABASE_URL a native server uses SQLite. Production SQLite and
# filesystem uploads require persistent storage, which Render Free lacks.
